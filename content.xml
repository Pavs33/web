reProperty><odeNavStructureProperty><key>titlePage</key><value>La energía que nos mueve I</value></odeNavStructureProperty><odeNavStructureProperty><key>visibility</key><value>true</value></odeNavStructureProperty><odeNavStructureProperty><key>highlight</key><value>true</value></odeNavStructureProperty><odeNavStructureProperty><key>description</key><value/></odeNavStructureProperty></odeNavStructureProperties><odePagStructures><odePagStructure><odePageId>20260324121623IIULDZ</odePageId><odeBlockId>20260324121623RMALGP</odeBlockId><blockName>Descripción de la Situación de Aprendizaje</blockName><iconName>technology</iconName><odePagStructureOrder>1</odePagStructureOrder><odePagStructureProperties><odePagStructureProperty><key>visibility</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>teacherOnly</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>allowToggle</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>minimized</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>identifier</key><value/></odePagStructureProperty><odePagStructureProperty><key>cssClass</key><value/></odePagStructureProperty></odePagStructureProperties><odeComponents><odeComponent><odePageId>20260324121623IIULDZ</odePageId><odeBlockId>20260324121623RMALGP</odeBlockId><odeIdeviceId>20260323103155243NTX</odeIdeviceId><odeIdeviceTypeName>text</odeIdeviceTypeName><htmlView>&lt;div class="exe-text-template"&gt;&lt;div class="textIdeviceContent"&gt;
            &lt;div class="exe-text-activity"&gt;
                &lt;div&gt;&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Etapa educativa y nivel&lt;/strong&gt;&lt;br&gt;Educación Secundaria Obligatoria (ESO)&lt;br&gt;Curso: 4º ESO&lt;br&gt;Materia: Física y Química&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Áreas, materias o módulos implicados&lt;/strong&gt;&lt;br&gt;- Física y Química&lt;br&gt;- Matemáticas&lt;br&gt;- Biología y Geología&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;La situación de aprendizaje fomenta la interdisciplinariedad al relacionar los cálculos energéticos con herramientas&amp;nbsp; matemáticas y el impacto de la energía en los sistemas naturales y en la salud.&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Agrupamientos y organización espacial&lt;/strong&gt;&lt;br&gt;Siguiendo los principios del Diseño Universal para el Aprendizaje (DUA) se emplearán diferentes modalidades de agrupamiento:&lt;/p&gt;
&lt;p&gt;- Trabajo individual para la resolución de ejercicios y reflexiones personales.&lt;br&gt;- Trabajo en parejas para lectura de textos científicos y resolución de problemas.&lt;br&gt;- Trabajo en grupos cooperativos heterogéneos (3-4 estudiantes) para la elaboración de productos digitales.&lt;br&gt;- Gran grupo para explicaciones, debates y puesta en común.&lt;br&gt;&lt;/p&gt;
&lt;p&gt;Espacios utilizados:&lt;/p&gt;
&lt;p&gt;- Aula ordinaria&lt;br&gt;- Aula TIC&lt;br&gt;- Laboratorio de Física y Química&lt;br&gt;- Plataforma educativa digital&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Temporalización&lt;/strong&gt;&lt;br&gt;Duración total: 7,5 sesiones&lt;/p&gt;
&lt;p&gt;Distribución orientativa:&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img src="{{context_path}}/20260323103155243NTX/mceclip0.png"&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;/strong&gt;&lt;br&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Productos que desarrollará el alumnado&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img src="{{context_path}}/20260323103155243NTX/mceclip5.png"&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Herramientas tecnológicas&lt;/strong&gt;&lt;br&gt;El alumnado y el profesorado utilizarán las siguientes herramientas:&lt;/p&gt;
&lt;p&gt;&lt;span style="text-decoration: underline;"&gt;Creación de recursos:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;Canva (infografías)&lt;br&gt;Genially o Canva (elementos interactivos)&lt;br&gt;CapCut / iMovie / Clipchamp (edición de vídeo)&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style="text-decoration: underline;"&gt;Recursos de aprendizaje:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Simuladores científicos (PhET)&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Vídeos educativos de YouTube&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Plataforma educativa del centro (Aula Virtual)&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style="text-decoration: underline;"&gt;Producción y entrega&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Microsoft Teams&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Otros recursos complementarios&lt;/strong&gt;&lt;br&gt;Libro de texto: Física y Química 4º ESO (Santillana)&lt;br&gt;Simuladores interactivos&lt;br&gt;Artículos de divulgación científica&lt;br&gt;Material de laboratorio&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p class="clearfix"&gt;&lt;/p&gt;&lt;/div&gt;
